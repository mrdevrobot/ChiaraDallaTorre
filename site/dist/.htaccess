<IfModule mod_rewrite.c>
RewriteEngine On
# Pagina Musica eliminata: contenuto in Chi Sono
RewriteRule ^musica/?$ https://www.chiaradallatorre.it/chi-sono/#voci-dal-silenzio [R=301,NE,L]
# Un solo nome: senza www -> www
RewriteCond %{HTTP_HOST} ^chiaradallatorre\.it$ [NC]
RewriteRule ^(.*)$ https://www.chiaradallatorre.it/$1 [R=301,L]
</IfModule>
